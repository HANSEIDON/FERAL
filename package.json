{
  "name": "zombie-fps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"서버,화면\" -c \"green,cyan\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm run start",
    "pack": "vite build && tar -czf feral.tgz dist server shared deploy package.json package-lock.json",
    "pack:itch": "node tools/pack_itch.mjs"
  },
  "dependencies": {
    "three": "^0.186.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.0"
  }
}
